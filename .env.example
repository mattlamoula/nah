# --- Stockage (obligatoire pour que le dashboard et le bot fonctionnent) ---
# Crée une base Upstash Redis gratuite (https://upstash.com), ou active Vercel KV
# (qui est un Upstash Redis managé) depuis l'onglet Storage de ton projet Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bot de trading ---
# RPC Solana. Le RPC public par défaut est limité en rate — un RPC dédié (Helius,
# QuickNode, Triton...) est recommandé dès que le bot tourne en continu.
RPC_URL=https://api.mainnet-beta.solana.com

# Clé privée du wallet du bot (base58, format export Phantom, OU tableau JSON
# façon solana-keygen). Ne JAMAIS committer cette valeur, ni la logger.
# Génère-la avec ./scripts/generate-bot-wallet.sh, qui l'envoie directement
# dans les secrets Vercel sans jamais l'afficher — ne la colle pas ici à la main.
BOT_PRIVATE_KEY=

# Adresse du contrat de $SKITY une fois mint sur StonkFun — cible des buybacks.
TOKEN_MINT=

# Double verrou pour le trading réel : DRY_RUN doit valoir "false" ET
# LIVE_TRADING_CONFIRMED doit valoir exactement "yes-i-understand-the-risk".
# Sans les deux, le bot reste en simulation quoi qu'il arrive.
DRY_RUN=true
LIVE_TRADING_CONFIRMED=

# Protège /api/cron-tick contre un déclenchement public. Vercel ajoute
# automatiquement ce header sur ses propres appels Cron quand la variable existe.
CRON_SECRET=
